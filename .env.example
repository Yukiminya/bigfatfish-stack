# ==== 必填 ====
# DeepSeek API Key（AstrBot / DSH 共用）：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-REPLACE_ME

# ==== QQ ====
# 机器人小号（雪糕鱼）与大号（主人）
QQ_SELF=3325646322
QQ_OWNER=641961016

# ==== NapCat 与 AstrBot 之间的鉴权 ====
# AstrBot 反向 WS 服务端口（NapCat 反向连到它）
ASTRBOT_WS_PORT=6199
# 反向 WS 的 token，自己编一串，两端填一样
ASTRBOT_WS_TOKEN=CHANGE_ME_astrbot_ws_token

# ==== AstrBot WebUI ====
ASTRBOT_WEB_USER=astrbot
ASTRBOT_WEB_PASSWORD=CHANGE_ME_astrbot_password
ASTRBOT_WEB_PORT=6185

# ==== NapCat WebUI ====
NAPCAT_WEBUI_PORT=6099
NAPCAT_WEBUI_TOKEN=CHANGE_ME_napcat_webui_token

# ==== QQ 语音通话插件（qq_voice_call）====
QQVOICE_WS_TOKEN=CHANGE_ME_qqvoice_ws_token

# ==== 电脑端 GPT-SoVITS（feiyu_voice / proactive 的远程 TTS）====
# 多条用英文逗号分隔，可写 http(s) 地址或 edge:<voice>
TTS_URLS=http://127.0.0.1:9880,edge:zh-CN-XiaoyiNeural

# ==== 可选：ASR（android_hands 的语音识别）====
SILICONFLOW_API_KEY=

# ==== 兼容旧电脑端 dsh-qq-access（legacy-pc）====
ONEBOT_TOKEN=CHANGE_ME_onebot_token
EVENTS_SECRET=CHANGE_ME_events_secret
STREAM_API_URL=http://127.0.0.1:3000
EVENTS_PORT=5701
